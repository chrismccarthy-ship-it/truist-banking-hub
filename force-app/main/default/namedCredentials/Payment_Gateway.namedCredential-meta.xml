<?xml version="1.0" encoding="UTF-8"?>
<!--
  Payment Gateway Named Credential (SecuredEndpoint).

  Apex references this as 'callout:Payment_Gateway'. It pairs the endpoint Url
  with the Payment_Gateway External Credential, which performs the OAuth 2.0
  client-credentials handshake and injects the Authorization header at runtime.

  PER-ORG: the Url below is a PLACEHOLDER. Replace it in each org
  (Setup > Named Credentials) with the real gateway base URL. No secrets live
  in this file.
-->
<NamedCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Payment Gateway</label>
    <namedCredentialType>SecuredEndpoint</namedCredentialType>
    <calloutStatus>Enabled</calloutStatus>
    <allowMergeFieldsInBody>false</allowMergeFieldsInBody>
    <allowMergeFieldsInHeader>false</allowMergeFieldsInHeader>
    <generateAuthorizationHeader>true</generateAuthorizationHeader>
    <namedCredentialParameters>
        <parameterName>Url</parameterName>
        <parameterType>Url</parameterType>
        <!-- PLACEHOLDER: replace per org with the real gateway base URL. -->
        <parameterValue>https://REPLACE_ME.payments.example.com</parameterValue>
    </namedCredentialParameters>
    <namedCredentialParameters>
        <!-- Links this Named Credential to the Payment_Gateway External Credential. -->
        <parameterName>ExternalCredential</parameterName>
        <parameterType>Authentication</parameterType>
        <parameterValue>Payment_Gateway</parameterValue>
    </namedCredentialParameters>
</NamedCredential>
