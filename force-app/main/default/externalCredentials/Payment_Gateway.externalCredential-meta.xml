<?xml version="1.0" encoding="UTF-8"?>
<!--
  Payment Gateway External Credential (OAuth 2.0, client-credentials flow).

  SECURITY: NO SECRETS ARE STORED IN THIS FILE. The OAuth Client Id and Client
  Secret are entered ONLY through the Setup UI (Setup > Named Credentials >
  External Credentials > Payment Gateway > Principals > PaymentGatewayPrincipal >
  Authentication Parameters). They are held as encrypted per-principal auth
  parameters and are never represented in source metadata.

  PER-ORG PLACEHOLDERS to fill in Setup:
    - TokenEndpointUrl : the gateway OAuth token endpoint
    - Scope            : the OAuth scope(s) required by the gateway
    - Client Id        : entered in Setup only (not here)
    - Client Secret    : entered in Setup only (not here)
-->
<ExternalCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Payment Gateway</label>
    <authenticationProtocol>OAuth</authenticationProtocol>
    <externalCredentialParameters>
        <!-- Selects the OAuth client-credentials grant (the parameter name encodes the variant). -->
        <parameterName>ClientCredentials</parameterName>
        <parameterType>AuthProtocolVariant</parameterType>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <externalCredentialParameters>
        <!-- Named principal; Client Id/Secret are attached to it in the Setup UI only. -->
        <parameterName>PaymentGatewayPrincipal</parameterName>
        <parameterType>NamedPrincipal</parameterType>
        <sequenceNumber>2</sequenceNumber>
    </externalCredentialParameters>
    <externalCredentialParameters>
        <!-- PLACEHOLDER: set the gateway OAuth token endpoint in Setup per org. -->
        <parameterName>TokenEndpointUrl</parameterName>
        <parameterType>AuthParameter</parameterType>
        <parameterValue>https://REPLACE_ME.payments.example.com/oauth/token</parameterValue>
        <sequenceNumber>3</sequenceNumber>
    </externalCredentialParameters>
    <externalCredentialParameters>
        <!-- PLACEHOLDER: set the required OAuth scope(s) per org. -->
        <parameterName>Scope</parameterName>
        <parameterType>AuthParameter</parameterType>
        <parameterValue>payments.read payments.write</parameterValue>
        <sequenceNumber>4</sequenceNumber>
    </externalCredentialParameters>
</ExternalCredential>
